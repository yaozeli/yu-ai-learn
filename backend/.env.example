# LLM Provider Strategy
# Primary provider: agnes | deepseek
LLM_PRIMARY_PROVIDER=agnes

# Agnes AI (primary)
AGNES_API_KEY=
AGNES_MODEL=
AGNES_BASE_URL=
AGNES_REQUEST_TIMEOUT=30

# DeepSeek (fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# WeChat Mini Program
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Poster mini-program code: release | trial | develop
WECHAT_QRCODE_ENV_VERSION=develop
WECHAT_QRCODE_PAGE=pages/index/index

# MySQL 8.x
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
MYSQL_TIMEZONE=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Runtime
APP_ENV=development
ENABLE_MOCK_LOGIN=false

# Avatar upload (public URL must be reachable from the mini program)
PUBLIC_BASE_URL=http://127.0.0.1:8000
AVATAR_UPLOAD_DIR=
